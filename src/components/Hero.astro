---
import Orb from './Orb.astro';
---

<section class='hero'>
  <div class='hero-content'>
    <p class='eyebrow'>WEB DEVELOPER · DESIGNER · TECHNOLOGIST</p>

    <h1>
      Stuart<br />
      McDonnell
    </h1>

    <p class='intro'>
      I design and build modern web experiences combining technology, creativity
      and thoughtful user experience.
    </p>

    <div class='hero-actions'>
      <a href='#work'>View my work</a>
      <a href='#contact'>Get in touch</a>
    </div>
  </div>

  <div class='hero-orb'>
    <Orb />
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 120px var(--page-padding) 80px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
  }

  .eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    font-weight: 700;
  }

  h1 {
    margin: 20px 0;

    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .intro {
    max-width: 550px;

    color: #9ba7b5;

    font-size: 1.1rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    gap: 20px;
    margin-top: 35px;
  }

  .hero-actions a {
    padding: 12px 20px;

    border: 1px solid var(--color-cyan);
    border-radius: 4px;

    color: var(--color-cyan);

    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .hero-actions a:hover {
    background: var(--color-cyan);
    color: var(--color-background);
    transform: translateY(-2px);
  }

  .hero-orb {
    display: grid;
    place-items: center;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 120px var(--page-padding) 60px;
    }
  }

  .hero-orb {
    display: grid;
    place-items: center;
    perspective: 1000px;
  }
</style>

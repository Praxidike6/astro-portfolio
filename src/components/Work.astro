    transition:
      border-color 0.6s ease,
      box-shadow 0.6s ease;
  }

  .lifecycle-grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(rgb(91 206 250 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(91 206 250 / 4%) 1px, transparent 1px);

    background-size: 35px 35px;

    mask-image: radial-gradient(circle at center, black 10%, transparent 75%);
  }

  .lifecycle-flow {
    position: absolute;
    inset: 0;

    display: grid;
    grid-template-columns: repeat(9, 1fr);
    align-items: start;

    padding: 75px 55px 0;
  }

  .lifecycle-step {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;

    min-width: 0;

    color: var(--color-text-muted);

    transition:
      color 0.5s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lifecycle-step.active {
    color: var(--color-cyan);
  }

  .lifecycle-dot {
    width: 12px;
    height: 12px;

    border: 1px solid rgb(91 206 250 / 35%);
    border-radius: 50%;

    background: var(--color-background);

    box-shadow: 0 0 8px rgb(91 206 250 / 5%);

    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .lifecycle-step.active .lifecycle-dot {
    background: var(--color-cyan);

    border-color: var(--color-cyan);

    box-shadow:
      0 0 12px rgb(91 206 250 / 60%),
      0 0 25px rgb(91 206 250 / 25%);
  }

  .lifecycle-step.ignite .lifecycle-dot {
    animation: lifecycleIgnite 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lifecycleIgnite {
    0% {
      transform: scale(1);
      box-shadow:
        0 0 8px rgb(91 206 250 / 20%),
        0 0 15px rgb(91 206 250 / 10%);
    }

    35% {
      transform: scale(1.65);
      box-shadow:
        0 0 16px var(--color-cyan),
        0 0 35px rgb(91 206 250 / 75%),
        0 0 55px rgb(91 206 250 / 35%);
    }

    100% {
      transform: scale(1.15);
      box-shadow:
        0 0 12px rgb(91 206 250 / 70%),
        0 0 25px rgb(91 206 250 / 30%);
    }
  }

  .lifecycle-name {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .lifecycle-connector {
    height: 1px;

    margin-top: 6px;

    background: rgb(91 206 250 / 15%);
  }

  .lifecycle-traveler {
    position: absolute;

    top: 0;
    left: 0;

    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 10px var(--color-cyan),
      0 0 24px rgb(91 206 250 / 60%);

    transform: translate(-50%, -50%);

    pointer-events: none;

    z-index: 5;

    transition:
      left 2.8s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.15s ease;

    animation: lifecycleTravelerGlow 2s ease-in-out infinite;
  }
  @keyframes lifecycleTravelerGlow {
    0%,
    100% {
      box-shadow:
        0 0 8px var(--color-cyan),
        0 0 18px rgb(91 206 250 / 40%);
    }

    50% {
      box-shadow:
        0 0 14px var(--color-cyan),
        0 0 30px rgb(91 206 250 / 70%);
    }
  }

  .lifecycle-connector span {
    position: absolute;

    top: 50%;
    left: 0;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 8px var(--color-cyan),
      0 0 18px rgb(91 206 250 / 40%);

    transform: translate(-50%, -50%);

    animation: lifecyclePulse 3s linear infinite;
  }

  .lifecycle-connector:nth-of-type(2) span {
    animation-delay: 0.6s;
  }

  .lifecycle-connector:nth-of-type(3) span {
    animation-delay: 1.2s;
  }

  .lifecycle-connector:nth-of-type(4) span {

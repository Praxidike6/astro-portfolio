  }

  @keyframes lifecyclePulse {
    from {
      left: 0;
      opacity: 0.25;
    }

    20% {
      opacity: 1;
    }

    to {
      left: 100%;
      opacity: 0.25;
    }
  }

  .lifecycle-stack {
    position: absolute;

    left: 25px;
    right: 25px;

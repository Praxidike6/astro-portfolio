---
import ParkinsonPreview from './work/ParkinsonPreview.astro';
import WellnessPreview from './work/WellnessPreview.astro';
import PizzaLifecycle from './work/PizzaLifecycle.astro';
---

<section class='work'>
  <div class='work-inner'>
    <div
      id='work'
      class='section-heading reveal'>
      <p class='section-number'>03</p>
      <h2>Work</h2>
    </div>

    <div class='projects reveal'>
      <article class='project'>
        <p class='project-number'>01</p>

        <div class='project-content'>
          <h3>Parkinson's Website Redevelopment</h3>

          <p class='project-description'>
            A complete website redevelopment for a client promoting and selling
            his book about living with Parkinson's. The site brings together the
            book, supporting information and social media into a single online
            presence.
          </p>

          <div class='project-tags'>
            <span>Wix</span>
            <span>JavaScript</span>
            <span>HTML/CSS</span>
            <span>Social Media</span>
          </div>

          <div class='project-meta'>
            <span>WEB DEVELOPMENT</span>
            <span>2026</span>
            <span>CLIENT PROJECT</span>
          </div>

          <a
            href='https://www.watchyourstep.com.au'
            class='project-link'
            target='_blank'
            rel='noopener noreferrer'>
            View project →
          </a>
        </div>

        <ParkinsonPreview />
      </article>

      <article class='project project-browser'>
        <p class='project-number'>02</p>

        <div class='project-content'>
          <h3>Wellness Website</h3>

          <p class='project-description'>
            A complete website development for a wellness business based in
            Victoria, built around a colour scheme selected by the client and
            integrated with online payments and scheduling.
          </p>

          <div class='project-tags'>
            <span>Squarespace</span>
            <span>JavaScript</span>
            <span>HTML/CSS</span>
            <span>Payments</span>
            <span>Scheduling</span>
          </div>

          <div class='project-meta'>
            <span>WEB DEVELOPMENT</span>
            <span>2025</span>
            <span>CLIENT PROJECT</span>
          </div>

          <a
            href='https://www.cowpercottagewellness.com.au/'
            class='project-link'
            target='_blank'
            rel='noopener noreferrer'>
            View project →
          </a>
        </div>

        <WellnessPreview />
      </article>

      <article class='project project-system'>
        <p class='project-number'>03</p>

        <div class='project-content'>
          <h3>React Fast Pizza Demo</h3>

          <p class='project-description'>
            A React-based pizza ordering application with live menu data,
            Redux-powered cart management, API-driven checkout,
            geolocation-assisted delivery details and real-time order tracking.
          </p>

          <div class='project-tags'>
            <span>React</span>
            <span>JavaScript</span>
            <span>Redux</span>
            <span>React Router</span>
            <span>Tailwind CSS</span>
            <span>REST API</span>
          </div>

          <div class='project-meta'>
            <span>REACT DEVELOPMENT</span>
            <span>2023</span>
            <span>DEMO PROJECT</span>
          </div>

          <a
            href='https://pizza-menu-app.onrender.com/'
            class='project-link'
            target='_blank'
            rel='noopener noreferrer'>
            View project →
          </a>
        </div>

        <PizzaLifecycle />
      </article>
    </div>
  </div>
</section>

<style>
  .work {
    padding: 80px var(--page-padding) 140px;
    overflow: clip;
  }

  .work-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 70px;
  }

  .section-number {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .projects {
    display: grid;
    gap: 30px;
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr;
    padding: 50px;
    border: 1px solid rgb(91 206 250 / 12%);
    background: rgb(255 255 255 / 2%);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
  }

  .project:hover {
    border-color: rgb(91 206 250 / 35%);
    background: rgb(91 206 250 / 3%);
  }

  .project-number {
    margin: 0;
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .project-content h3 {
    margin: 0 0 20px;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .project-description {
    max-width: 650px;
    margin: 0 0 25px;
    color: #9ba7b5;
    line-height: 1.8;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .project-tags span {
    padding: 6px 10px;
    border: 1px solid rgb(91 206 250 / 20%);
    border-radius: 3px;
    color: var(--color-cyan);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }

  .project-link {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-meta {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media (max-width: 1000px) {
    .work {
      padding: 60px var(--page-padding) 90px;
    }

    .section-heading {
      margin-bottom: 45px;
    }

    .projects {
      gap: 24px;
    }

    .project {
      padding: 40px;
    }
  }

  @media (max-width: 800px) {
    .work {
      padding: 60px var(--page-padding) 70px;
    }

    .section-heading {
      margin-bottom: 35px;
    }

    .project {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 30px;
    }
  }
</style>

---
import ParkinsonPreview from './work/ParkinsonPreview.astro';
import WellnessPreview from './work/WellnessPreview.astro';
import PizzaLifecycle from './work/PizzaLifecycle.astro';
---

<section class='work'>
  <div class='work-inner'>
    <div
      id='work'
      class='section-heading reveal'>
      <p class='section-number'>03</p>
      <h2>Work</h2>
    </div>

    <div class='projects reveal'>
      <article class='project'>
        <p class='project-number'>01</p>

        <ParkinsonPreview />
      </article>

      <article class='project project-browser'>
        <p class='project-number'>02</p>

        <WellnessPreview />
      </article>

      <article class='project project-system'>
        <p class='project-number'>03</p>

        <PizzaLifecycle />
      </article>
    </div>
  </div>
</section>

<style>
  .work {
    padding: 80px var(--page-padding) 140px;
    overflow: clip;
  }

  .work-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 70px;
  }

  .section-number {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .projects {
    display: grid;
    gap: 30px;
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr;
    padding: 50px;
    border: 1px solid rgb(91 206 250 / 12%);
    background: rgb(255 255 255 / 2%);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
  }

  .project:hover {
    border-color: rgb(91 206 250 / 35%);
    background: rgb(91 206 250 / 3%);
  }

  .project-number {
    margin: 0;
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  @media (max-width: 1000px) {
    .work {
      padding: 60px var(--page-padding) 90px;
    }

    .section-heading {
      margin-bottom: 45px;
    }

    .projects {
      gap: 24px;
    }

    .project {
      padding: 40px;
    }
  }

  @media (max-width: 800px) {
    .work {
      padding: 60px var(--page-padding) 70px;
    }

    .section-heading {
      margin-bottom: 35px;
    }

    .project {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 30px;
    }
  }
</style>

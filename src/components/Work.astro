  @media (prefers-reduced-motion: reduce) {
    .heartbeat-track,
    .browser-card,
    .browser-card-icon {
      animation: none !important;
    }
  }
</style>

<script>
  const lifecycleFlow = document.querySelector('.lifecycle-flow');

  const lifecycleSteps = document.querySelectorAll('.lifecycle-step');

  const lifecycleTraveler = document.querySelector('.lifecycle-traveler');

  const lifecyclePreview = document.querySelector('.lifecycle-preview');

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  if (
    lifecycleFlow &&
    lifecycleSteps.length &&
    lifecycleTraveler &&
    lifecyclePreview
  ) {
    let currentStep = 0;

    let lifecycleIsVisible = false;

    let travelTimer = null;
    let pauseTimer = null;
    let igniteTimer = null;

    const travelDuration = 2800;
    const pauseDuration = 900;
    const igniteDuration = 700;

    function clearLifecycleTimers() {
      if (travelTimer) {
        clearTimeout(travelTimer);
        travelTimer = null;
      }

      if (pauseTimer) {
        clearTimeout(pauseTimer);
        pauseTimer = null;
      }

      if (igniteTimer) {
        clearTimeout(igniteTimer);
        igniteTimer = null;
      }
    }

    function getStepPosition(index) {
      const flowRect = lifecycleFlow.getBoundingClientRect();

      const dot = lifecycleSteps[index].querySelector('.lifecycle-dot');

      if (!dot) {
        return {
          x: 0,
          y: 0,
        };
      }

      const dotRect = dot.getBoundingClientRect();

      return {
        x: dotRect.left + dotRect.width / 2 - flowRect.left,

        y: dotRect.top + dotRect.height / 2 - flowRect.top,
      };
    }

    function moveTravelerToStep(index) {
      const position = getStepPosition(index);

      lifecycleTraveler.style.left = `${position.x}px`;

      lifecycleTraveler.style.top = `${position.y}px`;
    }

    function activateStep(index) {
      lifecycleSteps.forEach((step, stepIndex) => {
        step.classList.toggle('active', stepIndex === index);
      });

      if (prefersReducedMotion) {
        return;
      }

      const targetStep = lifecycleSteps[index];

      targetStep.classList.remove('ignite');

      void targetStep.offsetWidth;

      targetStep.classList.add('ignite');

      igniteTimer = window.setTimeout(() => {
        targetStep.classList.remove('ignite');

        igniteTimer = null;
      }, igniteDuration);
    }

    function travelToNextStep() {
      if (!lifecycleIsVisible || prefersReducedMotion) {
        return;
      }

      const nextStep = (currentStep + 1) % lifecycleSteps.length;

      moveTravelerToStep(nextStep);

      travelTimer = window.setTimeout(() => {
        if (!lifecycleIsVisible) {
          return;
        }

        activateStep(nextStep);

        currentStep = nextStep;

        travelTimer = null;

        pauseTimer = window.setTimeout(() => {
          pauseTimer = null;

          travelToNextStep();
        }, pauseDuration);
      }, travelDuration);
    }

    function startLifecycle() {
      clearLifecycleTimers();

      activateStep(currentStep);
      moveTravelerToStep(currentStep);

      if (prefersReducedMotion) {
        return;
      }

      pauseTimer = window.setTimeout(() => {
        pauseTimer = null;

        travelToNextStep();
      }, pauseDuration);
    }

    function stopLifecycle() {
      clearLifecycleTimers();
    }

    const lifecycleObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;

        lifecycleIsVisible = entry.isIntersecting;

        if (lifecycleIsVisible) {
          startLifecycle();
        } else {
          stopLifecycle();
        }
      },
      {
        threshold: 0.05,
      },
    );

    lifecycleObserver.observe(lifecyclePreview);

    window.addEventListener('resize', () => {
      moveTravelerToStep(currentStep);
    });
  }
</script>

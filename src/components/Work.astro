  .lifecycle-preview {
    position: relative;

    grid-column: 1 / -1;

    min-height: 300px;

    margin-top: 40px;

    overflow: hidden;

    border: 1px solid rgb(91 206 250 / 12%);

    background:
      radial-gradient(circle at 50% 50%, rgb(74 144 226 / 8%), transparent 60%),
      var(--color-background);

    transition:
      border-color 0.6s ease,
      box-shadow 0.6s ease;
  }

  .lifecycle-grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(rgb(91 206 250 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(91 206 250 / 4%) 1px, transparent 1px);

    background-size: 35px 35px;

    mask-image: radial-gradient(circle at center, black 10%, transparent 75%);
  }

  .lifecycle-flow {
    position: absolute;
    inset: 0;

    display: grid;
    grid-template-columns: repeat(9, 1fr);
    align-items: start;

    padding: 75px 55px 0;
  }

  .lifecycle-step {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;

    min-width: 0;

    color: var(--color-text-muted);

    transition:
      color 0.5s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lifecycle-step.active {
    color: var(--color-cyan);
  }

  .lifecycle-dot {
    width: 12px;
    height: 12px;

    border: 1px solid rgb(91 206 250 / 35%);
    border-radius: 50%;

    background: var(--color-background);

    box-shadow: 0 0 8px rgb(91 206 250 / 5%);

    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .lifecycle-step.active .lifecycle-dot {
    background: var(--color-cyan);

    border-color: var(--color-cyan);

    box-shadow:
      0 0 12px rgb(91 206 250 / 60%),
      0 0 25px rgb(91 206 250 / 25%);
  }

  .lifecycle-step.ignite .lifecycle-dot {
    animation: lifecycleIgnite 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lifecycleIgnite {
    0% {
      transform: scale(1);
      box-shadow:
        0 0 8px rgb(91 206 250 / 20%),
        0 0 15px rgb(91 206 250 / 10%);
    }

    35% {
      transform: scale(1.65);
      box-shadow:
        0 0 16px var(--color-cyan),
        0 0 35px rgb(91 206 250 / 75%),
        0 0 55px rgb(91 206 250 / 35%);
    }

    100% {
      transform: scale(1.15);
      box-shadow:
        0 0 12px rgb(91 206 250 / 70%),
        0 0 25px rgb(91 206 250 / 30%);
    }
  }

  .lifecycle-name {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .lifecycle-connector {
    height: 1px;

    margin-top: 6px;

    background: rgb(91 206 250 / 15%);
  }

  .lifecycle-traveler {
    position: absolute;

    top: 0;
    left: 0;

    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 10px var(--color-cyan),
      0 0 24px rgb(91 206 250 / 60%);

    transform: translate(-50%, -50%);

    pointer-events: none;

    z-index: 5;

    transition:
      left 2.8s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.15s ease;

    animation: lifecycleTravelerGlow 2s ease-in-out infinite;
  }
  @keyframes lifecycleTravelerGlow {
    0%,
    100% {
      box-shadow:
        0 0 8px var(--color-cyan),
        0 0 18px rgb(91 206 250 / 40%);
    }

    50% {
      box-shadow:
        0 0 14px var(--color-cyan),
        0 0 30px rgb(91 206 250 / 70%);
    }
  }

  .lifecycle-connector span {
    position: absolute;

    top: 50%;
    left: 0;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 8px var(--color-cyan),
      0 0 18px rgb(91 206 250 / 40%);

    transform: translate(-50%, -50%);

    animation: lifecyclePulse 3s linear infinite;
  }

  .lifecycle-connector:nth-of-type(2) span {
    animation-delay: 0.6s;
  }

  .lifecycle-connector:nth-of-type(3) span {
    animation-delay: 1.2s;
  }

  .lifecycle-connector:nth-of-type(4) span {
    animation-delay: 1.8s;
  }

  @keyframes lifecyclePulse {
    from {
      left: 0;
      opacity: 0.25;
    }

    20% {
      opacity: 1;
    }

    to {
      left: 100%;
      opacity: 0.25;
    }
  }

  .lifecycle-stack {
    position: absolute;

    left: 25px;
    bottom: 18px;

    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    max-width: 65%;
  }

  .lifecycle-stack span {
    padding: 5px 8px;

    border: 1px solid rgb(91 206 250 / 12%);
    border-radius: 2px;

    color: #718092;

    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .lifecycle-label {
    position: absolute;

    right: 20px;
    bottom: 18px;

    color: var(--color-cyan);

    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .project:hover .lifecycle-preview {
    border-color: rgb(91 206 250 / 35%);

    box-shadow:
      inset 0 0 50px rgb(91 206 250 / 4%),
      0 0 30px rgb(91 206 250 / 5%);
  }

  .project:hover .lifecycle-step {
    transform: translateY(-3px);
  }

  .project:hover .lifecycle-step .lifecycle-dot {
    border-color: rgb(91 206 250 / 55%);
    box-shadow: 0 0 15px rgb(91 206 250 / 15%);
  }
  .project-system:hover .system-preview {
    border-color: rgb(91 206 250 / 35%);

    box-shadow:
      inset 0 0 50px rgb(91 206 250 / 4%),
      0 0 30px rgb(91 206 250 / 5%);
  }

  .project-system:hover .system-grid {
    transform: scale(1.04);
  }

  .project-system:hover .system-node-main {
    box-shadow: 0 0 40px rgb(91 206 250 / 20%);

    transform: translate(-50%, -50%) scale(1.05);
  }

  .project-system:hover .system-node {
    border-color: rgb(91 206 250 / 40%);
  }
</style>

<script>
  const lifecycleFlow = document.querySelector('.lifecycle-flow');

  const lifecycleSteps = document.querySelectorAll('.lifecycle-step');

  const lifecycleTraveler = document.querySelector('.lifecycle-traveler');

  if (lifecycleFlow && lifecycleSteps.length && lifecycleTraveler) {
    let currentStep = 0;

    const travelDuration = 2800;
    const pauseDuration = 900;
    const igniteDuration = 700;

    function getStepPosition(index) {
      const flowRect = lifecycleFlow.getBoundingClientRect();

      const dot = lifecycleSteps[index].querySelector('.lifecycle-dot');

      const dotRect = dot.getBoundingClientRect();

      return {
        x: dotRect.left + dotRect.width / 2 - flowRect.left,

        y: dotRect.top + dotRect.height / 2 - flowRect.top,
      };
    }

    function moveTravelerToStep(index) {
      const position = getStepPosition(index);

      lifecycleTraveler.style.left = `${position.x}px`;

      lifecycleTraveler.style.top = `${position.y}px`;
    }

    function activateStep(index) {
      lifecycleSteps.forEach((step, stepIndex) => {
        step.classList.toggle('active', stepIndex === index);
      });

      const targetStep = lifecycleSteps[index];

      targetStep.classList.remove('ignite');

      // Force a fresh animation cycle.
      void targetStep.offsetWidth;

      targetStep.classList.add('ignite');

      setTimeout(() => {
        targetStep.classList.remove('ignite');
      }, igniteDuration);
    }

    function travelToNextStep() {
      const nextStep = (currentStep + 1) % lifecycleSteps.length;

      // Start the journey to the next step.
      moveTravelerToStep(nextStep);

      // Only ignite the destination when
      // the traveller has arrived.
      setTimeout(() => {
        activateStep(nextStep);

        currentStep = nextStep;

        setTimeout(travelToNextStep, pauseDuration);
      }, travelDuration);
    }

    function initialiseLifecycle() {
      activateStep(0);

      moveTravelerToStep(0);

      setTimeout(travelToNextStep, pauseDuration);
    }

    initialiseLifecycle();

    window.addEventListener('resize', () => {
      moveTravelerToStep(currentStep);
    });
  }
</script>

  /* --------------------------------
    Project 03 — order lifecycle
  -------------------------------- */

  .lifecycle-preview {
    position: relative;

    grid-column: 1 / -1;

    min-height: 300px;

    margin-top: 40px;

    overflow: hidden;

    border: 1px solid rgb(91 206 250 / 12%);

    background:

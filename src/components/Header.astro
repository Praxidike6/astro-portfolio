<header>
  <nav
    class='nav'
    aria-label='Primary navigation'>
    <a
      class='logo'
      href='/'
      data-scroll='top'
      aria-label='Back to top'>
      STUART McDONNELL
    </a>

    <button
      class='menu-toggle'
      aria-label='Toggle navigation'
      aria-expanded='false'>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class='nav-links'>
      <a
        href='/'
        data-scroll='about'>
        ABOUT
      </a>
      <a
        href='/'
        data-scroll='skills'>
        SKILLS
      </a>
      <a
        href='/'
        data-scroll='work'>
        WORK
      </a>
      <a
        href='/'
        data-scroll='experience'>
        EXPERIENCE
      </a>
      <a
        href='/'
        data-scroll='contact'>
        CONTACT
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;

    top: 0;

    width: 100%;
    z-index: 10000;

    padding: 24px 40px;

    background: #05070b;

    border-bottom: 1px solid rgb(91 206 250 / 6%);
  }

  .nav {
    max-width: var(--content-width);
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: var(--color-text);

    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;

    transition: color 0.25s ease;
  }

  .logo:hover {
    color: var(--color-cyan);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    position: relative;

    color: #9ba7b5;

    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-links a::after {
    content: '';

    position: absolute;

    left: 0;
    bottom: -6px;

    width: 100%;
    height: 1px;

    background: var(--color-cyan);

    transform: scaleX(0);
    transform-origin: right;

    transition: transform 0.25s ease;
  }

  .nav-links a:hover {
    color: var(--color-cyan);

    transform: translateY(-2px);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-links a.active {
    color: var(--color-cyan);
  }

  .nav-links a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 850px) {
    header {
      padding: 20px;
    }

    .nav-links {
      gap: 16px;
    }

    .nav-links a {
      font-size: 0.6rem;
    }

    .logo {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 650px) {
    .nav-links {
      display: none;
    }
  }

  .menu-toggle {
    display: none;

    width: 32px;
    height: 24px;

    padding: 0;

    border: 0;

    background: transparent;

    cursor: pointer;
  }

  .menu-toggle span {
    display: block;

    width: 100%;
    height: 1px;

    background: var(--color-cyan);

    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .menu-toggle span + span {
    margin-top: 7px;
  }

  @media (max-width: 650px) {
    .menu-toggle {
      display: block;

      position: relative;
      z-index: 110;
    }

    .nav-links {
      position: fixed;

      top: 0;
      right: 0;

      width: min(78vw, 320px);
      height: 100vh;

      padding: 110px 35px 40px;

      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;

      background: rgb(5 7 11 / 96%);

      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);

      border-left: 1px solid rgb(91 206 250 / 10%);

      transform: translateX(100%);

      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-links.open {
      transform: translateX(0);
    }

    .nav-links a {
      font-size: 0.8rem;
    }

    .menu-toggle.open span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .menu-toggle.open span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.open span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>
<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');

  const mobileNav = document.querySelector<HTMLElement>('.nav-links');

  const scrollLinks =
    document.querySelectorAll<HTMLAnchorElement>('[data-scroll]');

  const sectionLinks = document.querySelectorAll<HTMLAnchorElement>(
    '.nav-links [data-scroll]',
  );

  /*
   * --------------------------------
   * Smooth navigation
   * --------------------------------
   */

  scrollLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();

      const targetId = link.dataset.scroll;

      if (!targetId) return;

      if (targetId === 'top') {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      } else {
        const target = document.getElementById(targetId);

        if (!target) return;

        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }

      /*
       * Keep the browser URL clean.
       */
      history.replaceState(
        null,
        '',
        `${window.location.pathname}${window.location.search}`,
      );

      /*
       * Close mobile navigation.
       */
      if (mobileNav && menuToggle) {
        mobileNav.classList.remove('open');

        menuToggle.classList.remove('open');

        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });
  });

  /*
   * --------------------------------
   * Mobile navigation
   * --------------------------------
   */

  if (menuToggle && mobileNav) {
    menuToggle.addEventListener('click', () => {
      const isOpen = mobileNav.classList.toggle('open');

      menuToggle.classList.toggle('open', isOpen);

      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }

  /*
   * --------------------------------
   * Active navigation highlighting
   * --------------------------------
   */

  function setActiveLink(sectionId: string | null) {
    sectionLinks.forEach((link) => {
      const isActive = link.dataset.scroll === sectionId;

      link.classList.toggle('active', isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  /*
   * The IDs such as "about" are currently
   * attached to section headings.
   *
   * We find each ID and then observe its
   * containing <section>, rather than only
   * observing the heading.
   */

  const sections = Array.from(sectionLinks)
    .map((link) => {
      const id = link.dataset.scroll;

      if (!id) return null;

      const target = document.getElementById(id);

      const section = target?.closest('section');

      if (!section) return null;

      return {
        id,
        section,
      };
    })
    .filter(
      (
        item,
      ): item is {
        id: string;
        section: HTMLElement;
      } => item !== null,
    );

  if (sections.length) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          const current = sections.find(
            ({section}) => section === entry.target,
          );

          if (!current) return;

          setActiveLink(current.id);
        });
      },
      {
        /*
         * This creates an invisible horizontal
         * detection zone through the middle
         * portion of the viewport.
         */
        rootMargin: '-35% 0px -55% 0px',

        threshold: 0,
      },
    );

    sections.forEach(({section}) => {
      sectionObserver.observe(section);
    });
  }

  /*
   * Clear the active navigation while
   * the visitor is in the Hero area.
   */

  function checkHeroPosition() {
    const firstSection = sections[0]?.section;

    if (!firstSection) return;

    const firstSectionTop = firstSection.getBoundingClientRect().top;

    if (firstSectionTop > window.innerHeight * 0.5) {
      setActiveLink(null);
    }
  }

  window.addEventListener('scroll', checkHeroPosition, {
    passive: true,
  });

  checkHeroPosition();

  /*
   * Remove any old hash if somebody loads
   * an older bookmarked URL such as #about.
   */

  if (window.location.hash) {
    history.replaceState(
      null,
      '',
      `${window.location.pathname}${window.location.search}`,
    );
  }
</script>

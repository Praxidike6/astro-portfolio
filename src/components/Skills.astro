---
import {Icon} from 'astro-icon/components';

const skillGroups = [
  {
    title: 'Web Development',
    skills: [
      {
        name: 'HTML',
        icon: 'logos:html-5',
      },
      {
        name: 'CSS',
        icon: 'logos:css-3',
      },
      {
        name: 'JavaScript',
        icon: 'logos:javascript',
      },
      {
        name: 'TypeScript',
        icon: 'logos:typescript-icon',
      },
      {
        name: 'Astro',
        icon: 'simple-icons:astro',
      },
      {
        name: 'React',
        icon: 'logos:react',
      },
      {
        name: 'PHP',
        icon: 'logos:php',
      },
    ],
  },

  {
    title: 'Design & Accessibility',
    skills: [
      {
        name: 'UI Design',
        icon: 'lucide:palette',
      },
      {
        name: 'UX',
        icon: 'lucide:users',
      },
      {
        name: 'Responsive Design',
        icon: 'lucide:monitor-smartphone',
      },
      {
        name: 'Accessibility',
        icon: 'lucide:accessibility',
      },
      {
        name: 'Figma',
        icon: 'logos:figma',
      },
      {
        name: 'Tailwind CSS',
        icon: 'logos:tailwindcss-icon',
      },
    ],
  },

  {
    title: 'Platforms & Infrastructure',
    skills: [
      {
        name: 'WordPress',
        icon: 'logos:wordpress-icon',
      },
      {
        name: 'Wix',
        icon: 'simple-icons:wix',
      },
      {
        name: 'Squarespace',
        icon: 'simple-icons:squarespace',
      },
      {
        name: 'Shopify',
        icon: 'logos:shopify',
      },
      {
        name: 'Azure',
        icon: 'logos:microsoft-azure',
      },
      {
        name: 'AWS',
        icon: 'simple-icons:amazonwebservices',
      },
      {
        name: 'APIs',
        icon: 'lucide:braces',
      },
      {
        name: 'Automation',
        icon: 'lucide:workflow',
      },
      {
        name: 'Web Administration',
        icon: 'lucide:server-cog',
      },
    ],
  },

  {
    title: 'Tools, AI & Databases',
    skills: [
      {
        name: 'Git',
        icon: 'logos:git-icon',
      },
      {
        name: 'VS Code',
        icon: 'logos:visual-studio-code',
      },
      {
        name: 'Bash / Unix Shell',
        icon: 'lucide:square-terminal',
      },
      {
        name: 'AI / LLMs',
        icon: 'simple-icons:openai',
      },
      {
        name: 'Oracle',
        icon: 'lucide:database',
      },
      {
        name: 'Supabase',
        icon: 'logos:supabase-icon',
      },
      {
        name: 'MongoDB',
        icon: 'logos:mongodb-icon',
      },
    ],
  },
];
---

<section class='skills'>
  <div class='skills-inner'>
    <div
      id='skills'
      class='section-heading'>
      <p class='section-number'>02</p>
      <h2>Skills</h2>
    </div>

    <div class='skills-grid'>
      {
        skillGroups.map((group) => (
          <article class='skill-group'>
            <h3>{group.title}</h3>

            <ul>
              {group.skills.map((skill) => (
                <li class='skill-item'>
                  <span
                    class='skill-icon'
                    aria-hidden='true'>
                    <Icon
                      name={skill.icon}
                      size='20'
                    />
                  </span>

                  <span class='skill-name'>{skill.name}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 140px var(--page-padding);
  }

  .skills-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 20px;

    margin-bottom: 70px;
  }

  .section-number {
    color: var(--color-cyan);

    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 0;

    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 24px;
  }

  .skill-group {
    padding: 30px;

    border: 1px solid rgb(91 206 250 / 10%);
    border-radius: 4px;

    background: rgb(255 255 255 / 1.5%);

    transition:
      border-color 0.3s ease,
      background 0.3s ease,
      transform 0.3s ease;
  }

  .skill-group:hover {
    border-color: rgb(91 206 250 / 25%);

    background: rgb(91 206 250 / 3%);

    transform: translateY(-2px);
  }

  .skill-group h3 {
    margin: 0 0 24px;

    color: var(--color-text);

    font-size: 1rem;
    font-weight: 700;

    letter-spacing: 0.03em;
  }

  .skill-group ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 10px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .skill-item {
    display: flex;
    align-items: center;

    gap: 11px;

    min-width: 0;

    padding: 11px 12px;

    border: 1px solid rgb(91 206 250 / 8%);
    border-radius: 3px;

    background: rgb(5 7 11 / 35%);

    color: #9ba7b5;

    font-size: 0.75rem;

    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease;
  }

  .skill-item:hover {
    color: var(--color-text);

    border-color: rgb(91 206 250 / 25%);

    background: rgb(91 206 250 / 5%);

    transform: translateX(2px);
  }

  .skill-icon {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 24px;
    height: 24px;

    color: var(--color-cyan);
  }

  :global(.skill-icon svg) {
    display: block;

    width: 20px;
    height: 20px;
  }

  .skill-name {
    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .skills {
      padding: 100px var(--page-padding);
    }

    .section-heading {
      margin-bottom: 50px;
    }

    .skills-grid {
      gap: 18px;
    }

    .skill-group {
      padding: 26px;
    }
  }

  @media (max-width: 800px) {
    .skills {
      padding: 80px var(--page-padding);
    }

    .skills-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .skill-group ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .skills {
      padding: 70px var(--page-padding);
    }

    .section-heading {
      gap: 14px;
      margin-bottom: 38px;
    }

    .skill-group {
      padding: 22px;
    }

    .skill-group h3 {
      margin-bottom: 18px;
    }

    .skill-group ul {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .skill-item {
      padding: 10px 12px;
    }

    .skill-name {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-group,
    .skill-item {
      transition: none;
    }

    .skill-group:hover,
    .skill-item:hover {
      transform: none;
    }
  }
</style>

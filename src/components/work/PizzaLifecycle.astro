---
import ProjectCard from './ProjectCard.astro';

interface Props {
  number: string;
}

const {number} = Astro.props;
---

<ProjectCard
  number={number}
  variant='project-system'
  tags={[
    'React',
    'JavaScript',
    'Redux',
    'React Router',
    'Tailwind CSS',
    'REST API',
  ]}
  type='React Development'
  year='2023'
  context='Demo Project'
  href='https://pizza-menu-app.onrender.com/'>
  <div
    slot='content'
    class='project-details'>
    <h3>React Fast Pizza</h3>

    <p class='project-description'>
      A React-based pizza ordering application that demonstrates a complete
      customer journey from menu browsing through checkout and order tracking.
      The project combines live API data, Redux-powered cart management,
      geolocation-assisted delivery details and client-side routing to create a
      responsive single-page ordering experience.
    </p>

    <p class='project-role'>
      <span>ROLE</span>
      React application development · State management · API integration
    </p>
  </div>

  <div
    slot='preview'
    class='lifecycle-preview'>
    <div class='lifecycle-grid'></div>

    <div class='lifecycle-flow'>
      <div class='lifecycle-step active'>
        <span class='lifecycle-dot'></span>
        <span class='lifecycle-name'>MENU</span>
      </div>

      <div class='lifecycle-connector'></div>

      <div class='lifecycle-step'>
        <span class='lifecycle-dot'></span>
        <span class='lifecycle-name'>CART</span>
      </div>

      <div class='lifecycle-connector'></div>

      <div class='lifecycle-step'>
        <span class='lifecycle-dot'></span>
        <span class='lifecycle-name'>CHECKOUT</span>
      </div>

      <div class='lifecycle-connector'></div>

      <div class='lifecycle-step'>
        <span class='lifecycle-dot'></span>
        <span class='lifecycle-name'>ORDER</span>
      </div>

      <div class='lifecycle-connector'></div>

      <div class='lifecycle-step'>
        <span class='lifecycle-dot'></span>
        <span class='lifecycle-name'>TRACKING</span>
      </div>

      <span
        class='lifecycle-traveler'
        aria-hidden='true'>
      </span>
    </div>

    <div class='lifecycle-stack'>
      <span>REACT</span>
      <span>REACT ROUTER</span>
      <span>REDUX TOOLKIT</span>
      <span>REST API</span>
      <span>GEOLOCATION</span>
    </div>

    <div class='preview-info'>
      <span class='preview-label'>PROJECT 03</span>
      <span class='preview-title'>REACT FAST PIZZA</span>
    </div>
  </div>
</ProjectCard>

<style>
  .project-role {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin: 0 0 25px;

    color: #9ba7b5;

    font-size: 0.72rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .project-role span {
    color: var(--color-cyan);

    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .project-details h3 {
    margin: 0 0 20px;

    font-size: clamp(1.8rem, 3vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .project-description {
    max-width: 650px;

    margin: 0 0 25px;

    color: #9ba7b5;

    line-height: 1.8;
  }

  .lifecycle-preview {
    position: relative;

    grid-column: 1 / -1;

    min-height: 300px;
    margin-top: 40px;

    overflow: hidden;

    border: 1px solid rgb(91 206 250 / 12%);

    background:
      radial-gradient(circle at 50% 50%, rgb(74 144 226 / 8%), transparent 60%),
      var(--color-background);

    transition:
      border-color 0.6s ease,
      box-shadow 0.6s ease;
  }

  .lifecycle-grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(rgb(91 206 250 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(91 206 250 / 4%) 1px, transparent 1px);

    background-size: 35px 35px;

    mask-image: radial-gradient(circle at center, black 10%, transparent 75%);
  }

  .lifecycle-flow {
    position: absolute;
    inset: 0;

    display: grid;
    grid-template-columns: repeat(9, 1fr);

    align-items: start;

    padding: 75px 55px 0;
  }

  .lifecycle-step {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    gap: 12px;

    min-width: 0;

    color: var(--color-text-muted);

    transition:
      color 0.5s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lifecycle-step.active {
    color: var(--color-cyan);
  }

  .lifecycle-dot {
    width: 12px;
    height: 12px;

    border: 1px solid rgb(91 206 250 / 35%);
    border-radius: 50%;

    background: var(--color-background);

    box-shadow: 0 0 8px rgb(91 206 250 / 5%);

    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .lifecycle-step.active .lifecycle-dot {
    background: var(--color-cyan);
    border-color: var(--color-cyan);

    box-shadow:
      0 0 12px rgb(91 206 250 / 60%),
      0 0 25px rgb(91 206 250 / 25%);
  }

  .lifecycle-step.ignite .lifecycle-dot {
    animation: lifecycleIgnite 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lifecycleIgnite {
    0% {
      transform: scale(1);

      box-shadow:
        0 0 8px rgb(91 206 250 / 20%),
        0 0 15px rgb(91 206 250 / 10%);
    }

    35% {
      transform: scale(1.65);

      box-shadow:
        0 0 16px var(--color-cyan),
        0 0 35px rgb(91 206 250 / 75%),
        0 0 55px rgb(91 206 250 / 35%);
    }

    100% {
      transform: scale(1.15);

      box-shadow:
        0 0 12px rgb(91 206 250 / 70%),
        0 0 25px rgb(91 206 250 / 30%);
    }
  }

  .lifecycle-name {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .lifecycle-connector {
    height: 1px;

    margin-top: 6px;

    background: rgb(91 206 250 / 15%);
  }

  .lifecycle-traveler {
    position: absolute;

    top: 0;
    left: 0;

    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 10px var(--color-cyan),
      0 0 24px rgb(91 206 250 / 60%);

    transform: translate(-50%, -50%);

    pointer-events: none;

    z-index: 5;

    transition:
      left 2.8s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.15s ease;

    animation: lifecycleTravelerGlow 2s ease-in-out infinite;
  }

  @keyframes lifecycleTravelerGlow {
    0%,
    100% {
      box-shadow:
        0 0 8px var(--color-cyan),
        0 0 18px rgb(91 206 250 / 40%);
    }

    50% {
      box-shadow:
        0 0 14px var(--color-cyan),
        0 0 30px rgb(91 206 250 / 70%);
    }
  }

  .lifecycle-stack {
    position: absolute;

    left: 25px;
    right: 25px;
    bottom: 64px;

    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    max-width: none;
  }

  .lifecycle-stack span {
    padding: 5px 8px;

    border: 1px solid rgb(91 206 250 / 12%);
    border-radius: 2px;

    color: #718092;

    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .preview-info {
    position: absolute;

    left: 20px;
    bottom: 15px;

    display: flex;
    flex-direction: column;

    gap: 5px;

    z-index: 3;
  }

  .preview-label {
    color: var(--color-cyan);

    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .preview-title {
    color: var(--color-text-muted);

    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  :global(.project:hover) .lifecycle-preview {
    border-color: rgb(91 206 250 / 35%);

    box-shadow:
      inset 0 0 50px rgb(91 206 250 / 4%),
      0 0 30px rgb(91 206 250 / 5%);
  }

  :global(.project:hover) .lifecycle-step {
    transform: translateY(-3px);
  }

  :global(.project:hover) .lifecycle-step .lifecycle-dot {
    border-color: rgb(91 206 250 / 55%);

    box-shadow: 0 0 15px rgb(91 206 250 / 15%);
  }

  @media (max-width: 1000px) and (min-width: 801px) {
    .lifecycle-preview {
      min-height: 320px;
    }

    .lifecycle-stack {
      left: 25px;
      right: 25px;
      bottom: 64px;

      max-width: none;

      gap: 8px;
    }
  }

  @media (max-width: 600px) {
    .lifecycle-preview {
      min-height: 440px;

      margin-top: 30px;
    }

    .lifecycle-flow {
      inset: 0;

      display: grid;

      grid-template-columns: 1fr;
      grid-template-rows: repeat(9, auto);

      align-content: start;

      padding: 45px 40px 130px;
    }

    .lifecycle-step {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;

      gap: 14px;

      min-width: 0;
    }

    .lifecycle-name {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
    }

    .lifecycle-connector {
      width: 1px;
      height: 30px;

      margin: 0 0 0 6px;

      background: rgb(91 206 250 / 15%);
    }

    .lifecycle-traveler {
      transition:
        top 2.8s cubic-bezier(0.16, 1, 0.3, 1),
        left 0.15s ease;
    }

    .lifecycle-stack {
      left: 20px;
      right: 20px;
      bottom: 64px;

      max-width: none;

      gap: 6px;
    }

    .lifecycle-stack span {
      padding: 5px 7px;

      font-size: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lifecycle-traveler,
    .lifecycle-step.ignite .lifecycle-dot {
      animation: none !important;
    }
  }
</style>

<script>
  const lifecycleFlow = document.querySelector<HTMLElement>('.lifecycle-flow');

  const lifecycleSteps =
    document.querySelectorAll<HTMLElement>('.lifecycle-step');

  const lifecycleTraveler = document.querySelector<HTMLElement>(
    '.lifecycle-traveler',
  );

  const lifecyclePreview =
    document.querySelector<HTMLElement>('.lifecycle-preview');

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  if (
    lifecycleFlow &&
    lifecycleSteps.length &&
    lifecycleTraveler &&
    lifecyclePreview
  ) {
    const flow = lifecycleFlow;
    const steps = lifecycleSteps;
    const traveler = lifecycleTraveler;
    const preview = lifecyclePreview;

    let currentStep = 0;
    let lifecycleIsVisible = false;

    let travelTimer: ReturnType<typeof setTimeout> | null = null;
    let pauseTimer: ReturnType<typeof setTimeout> | null = null;
    let igniteTimer: ReturnType<typeof setTimeout> | null = null;

    const travelDuration = 2800;
    const pauseDuration = 900;
    const igniteDuration = 700;

    function clearLifecycleTimers() {
      if (travelTimer) {
        clearTimeout(travelTimer);
        travelTimer = null;
      }

      if (pauseTimer) {
        clearTimeout(pauseTimer);
        pauseTimer = null;
      }

      if (igniteTimer) {
        clearTimeout(igniteTimer);
        igniteTimer = null;
      }
    }

    function getStepPosition(index: number) {
      const step = steps[index];

      if (!step) {
        return {x: 0, y: 0};
      }

      const dot = step.querySelector<HTMLElement>('.lifecycle-dot');

      if (!dot) {
        return {x: 0, y: 0};
      }

      const flowRect = flow.getBoundingClientRect();
      const dotRect = dot.getBoundingClientRect();

      return {
        x: dotRect.left + dotRect.width / 2 - flowRect.left,
        y: dotRect.top + dotRect.height / 2 - flowRect.top,
      };
    }

    function moveTravelerToStep(index: number) {
      const position = getStepPosition(index);

      traveler.style.left = `${position.x}px`;
      traveler.style.top = `${position.y}px`;
    }

    function activateStep(index: number) {
      steps.forEach((step, stepIndex) => {
        step.classList.toggle('active', stepIndex === index);
      });

      if (prefersReducedMotion) {
        return;
      }

      const targetStep = steps[index];

      if (!targetStep) {
        return;
      }

      targetStep.classList.remove('ignite');

      void targetStep.offsetWidth;

      targetStep.classList.add('ignite');

      igniteTimer = window.setTimeout(() => {
        targetStep.classList.remove('ignite');
        igniteTimer = null;
      }, igniteDuration);
    }

    function travelToNextStep() {
      if (!lifecycleIsVisible || prefersReducedMotion) {
        return;
      }

      const nextStep = (currentStep + 1) % steps.length;

      moveTravelerToStep(nextStep);

      travelTimer = window.setTimeout(() => {
        if (!lifecycleIsVisible) {
          return;
        }

        activateStep(nextStep);

        currentStep = nextStep;
        travelTimer = null;

        pauseTimer = window.setTimeout(() => {
          pauseTimer = null;

          travelToNextStep();
        }, pauseDuration);
      }, travelDuration);
    }

    function startLifecycle() {
      clearLifecycleTimers();

      activateStep(currentStep);
      moveTravelerToStep(currentStep);

      if (prefersReducedMotion) {
        return;
      }

      pauseTimer = window.setTimeout(() => {
        pauseTimer = null;

        travelToNextStep();
      }, pauseDuration);
    }

    function stopLifecycle() {
      clearLifecycleTimers();
    }

    const lifecycleObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;

        lifecycleIsVisible = entry.isIntersecting;

        if (lifecycleIsVisible) {
          startLifecycle();
        } else {
          stopLifecycle();
        }
      },
      {threshold: 0.05},
    );

    lifecycleObserver.observe(preview);

    window.addEventListener('resize', () => {
      moveTravelerToStep(currentStep);
    });
  }
</script>

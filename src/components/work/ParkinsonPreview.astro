---
import ProjectCard from './ProjectCard.astro';

interface Props {
  number: string;
}

const {number} = Astro.props;
---

<ProjectCard number={number}>
  <div class='project-content'>
    <h3>Watch Your Step</h3>

    <p class='project-description'>
      A complete website redevelopment for an author living with Parkinson's,
      created to bring his book, supporting resources and social media into a
      single accessible online presence. I reworked the structure, navigation
      and presentation to make the site easier to use across devices and to give
      visitors a clearer path to discover the book and related content.
    </p>
    <p class='project-role'>
      <span>ROLE</span>
      Website redevelopment · UX structure · Responsive presentation
    </p>

    <div class='project-tags'>
      <span>Wix</span>
      <span>JavaScript</span>
      <span>HTML/CSS</span>
      <span>Social Media</span>
    </div>

    <div class='project-meta'>
      <span>WEB DEVELOPMENT</span>
      <span>2026</span>
      <span>CLIENT PROJECT</span>
    </div>

    <a
      href='https://www.watchyourstep.com.au'
      class='project-link'
      target='_blank'
      rel='noopener noreferrer'>
      View project →
    </a>
  </div>
  <div class='project-preview'>
    <div class='preview-grid'></div>

    <div class='preview-particles'>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class='preview-orbit'>
      <div class='preview-orb'></div>
      <div class='preview-ring preview-ring-back'></div>
      <div class='preview-ring preview-ring-front'></div>
    </div>

    <div class='preview-info'>
      <span class='preview-label'>PROJECT 01</span>
      <span class='preview-title'>WATCH YOUR STEP</span>
    </div>
  </div>
</ProjectCard>

<style>
  .project-role {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin: 0 0 25px;

    color: #9ba7b5;

    font-size: 0.72rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .project-role span {
    color: var(--color-cyan);

    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .project-content h3 {
    margin: 0 0 20px;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .project-description {
    max-width: 650px;
    margin: 0 0 25px;
    color: #9ba7b5;
    line-height: 1.8;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .project-tags span {
    padding: 6px 10px;
    border: 1px solid rgb(91 206 250 / 20%);
    border-radius: 3px;
    color: var(--color-cyan);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }

  .project-link {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-meta {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .project-preview {
    position: relative;
    grid-column: 1 / -1;

    min-height: 280px;
    margin-top: 40px;

    overflow: visible;

    border: 1px solid rgb(91 206 250 / 12%);

    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(91 206 250 / 10%),
        transparent 55%
      ),
      var(--color-background);

    display: flex;
    align-items: center;
    justify-content: center;

    transition:
      border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.6s ease;
  }

  .preview-particles {
    position: absolute;
    inset: 0;

    pointer-events: none;
  }

  .preview-particles span {
    position: absolute;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 8px var(--color-cyan),
      0 0 16px rgb(91 206 250 / 40%);

    opacity: 0.6;

    animation: previewParticlePulse 3s ease-in-out infinite;
  }

  .preview-particles span:nth-child(1) {
    top: 25%;
    left: 30%;
  }

  .preview-particles span:nth-child(2) {
    top: 35%;
    left: 70%;
    animation-delay: 0.5s;
  }

  .preview-particles span:nth-child(3) {
    top: 65%;
    left: 25%;
    animation-delay: 1s;
  }

  .preview-particles span:nth-child(4) {
    top: 72%;
    left: 72%;
    animation-delay: 1.5s;
  }

  .preview-particles span:nth-child(5) {
    top: 18%;
    left: 55%;
    animation-delay: 2s;
  }

  .preview-particles span:nth-child(6) {
    top: 78%;
    left: 48%;
    animation-delay: 2.5s;
  }

  @keyframes previewParticlePulse {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.7);
    }

    50% {
      opacity: 0.8;
      transform: scale(1.2);
    }
  }

  .preview-grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(rgb(91 206 250 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(91 206 250 / 5%) 1px, transparent 1px);

    background-size: 30px 30px;

    mask-image: radial-gradient(circle, black 20%, transparent 75%);

    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preview-orbit {
    position: relative;
    z-index: 2;

    width: 240px;
    height: 240px;

    display: grid;
    place-items: center;

    perspective: 800px;
    transform-style: preserve-3d;
  }

  .preview-orb {
    position: relative;
    z-index: 2;

    width: 160px;
    height: 160px;

    border-radius: 50%;

    background: radial-gradient(
      circle at 35% 30%,
      white 0%,
      var(--color-cyan) 8%,
      var(--color-blue) 35%,
      #101722 70%,
      #05070b 100%
    );

    box-shadow:
      0 0 30px rgb(91 206 250 / 25%),
      0 0 80px rgb(74 144 226 / 15%);

    transition:
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.8s cubic-bezier(0.16, 1, 0.3, 1);

    animation: previewOrbPulse 4s ease-in-out infinite;
  }

  @keyframes previewOrbPulse {
    0%,
    100% {
      filter: brightness(1);
    }

    50% {
      filter: brightness(1.12);
    }
  }

  .preview-ring {
    position: absolute;

    width: 210px;
    height: 90px;

    border: 1px solid rgb(91 206 250 / 35%);
    border-radius: 50%;

    pointer-events: none;

    transform: rotateX(68deg);
  }

  .preview-ring-back {
    z-index: 1;

    opacity: 0.35;

    clip-path: inset(0 0 50% 0);
  }

  .preview-ring-front {
    z-index: 5;

    opacity: 0.8;

    clip-path: inset(50% 0 0 0);
  }

  .preview-ring-front::after {
    content: '';

    position: absolute;

    width: 7px;
    height: 7px;

    top: 50%;
    left: 50%;

    margin-left: -3.5px;
    margin-top: -3.5px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 8px var(--color-cyan),
      0 0 18px rgb(91 206 250 / 60%);

    animation: previewOrbitPoint 4s linear infinite;
  }

  @keyframes previewOrbitPoint {
    from {
      transform: rotate(0deg) translateX(105px) rotate(0deg);
    }

    to {
      transform: rotate(360deg) translateX(105px) rotate(-360deg);
    }
  }

  .preview-info {
    position: absolute;

    left: 20px;
    bottom: 15px;

    display: flex;
    flex-direction: column;
    gap: 5px;

    z-index: 3;
  }

  .preview-label {
    color: var(--color-cyan);

    font-size: 0.65rem;
    font-weight: 700;

    letter-spacing: 0.15em;
  }

  .preview-title {
    color: var(--color-text-muted);

    font-size: 0.6rem;
    font-weight: 500;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.project:hover) .project-preview {
    border-color: rgb(91 206 250 / 35%);
  }

  :global(.project:hover) .preview-grid {
    transform: scale(1.04);
  }

  :global(.project:hover) .preview-orb {
    transform: scale(1.08);

    box-shadow:
      0 0 40px rgb(91 206 250 / 35%),
      0 0 100px rgb(74 144 226 / 20%);
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-particles span,
    .preview-orb,
    .preview-ring-front::after {
      animation: none;
    }
  }
</style>

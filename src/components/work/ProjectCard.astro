---
interface Props {
  number: string;
  variant?: string;
}

const {number, variant = ''} = Astro.props;

const projectClass = ['project', variant].filter(Boolean).join(' ');
---

<article class={projectClass}>
  <p class='project-number'>{number}</p>

  <slot />
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 80px 1fr;

    padding: 50px;

    border: 1px solid rgb(91 206 250 / 12%);
    background: rgb(255 255 255 / 2%);

    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
  }

  .project:hover {
    border-color: rgb(91 206 250 / 35%);
    background: rgb(91 206 250 / 3%);
  }

  .project-number {
    margin: 0;

    color: var(--color-cyan);

    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  @media (max-width: 1000px) {
    .project {
      padding: 40px;
    }
  }

  @media (max-width: 800px) {
    .project {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 30px;
    }
  }
</style>

    filter: blur(30px);

    opacity: 0.75;

    pointer-events: none;
  }

  .brain-image {
    position: relative;
    z-index: 1;

    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;

    filter: brightness(1) contrast(1.08) saturate(1.05)
      drop-shadow(0 0 10px rgb(91 206 250 / 20%))
      drop-shadow(0 0 24px rgb(74 144 226 / 10%));

    will-change: filter, opacity;
  }

  /*
   * Hover sequence:
   * normal → dim → flare back → normal
   */

  .about-visual:hover .brain-image {
    animation: brainDimFlash 1.15s ease-out 1;
  }

  @keyframes brainDimFlash {
    0% {
      opacity: 1;

      filter: brightness(1) contrast(1.08) saturate(1.05)
        drop-shadow(0 0 10px rgb(91 206 250 / 20%))
        drop-shadow(0 0 24px rgb(74 144 226 / 10%));
    }

    18% {
      opacity: 0.72;

      filter: brightness(0.5) contrast(1.05) saturate(0.85)
        drop-shadow(0 0 4px rgb(91 206 250 / 8%))
        drop-shadow(0 0 10px rgb(74 144 226 / 5%));
    }

    42% {
      opacity: 0.68;

      filter: brightness(0.42) contrast(1.04) saturate(0.78)
        drop-shadow(0 0 3px rgb(91 206 250 / 6%))
        drop-shadow(0 0 7px rgb(74 144 226 / 4%));
    }

    64% {
      opacity: 1;

      filter: brightness(1.35) contrast(1.12) saturate(1.12)
        drop-shadow(0 0 14px rgb(255 255 255 / 18%))
        drop-shadow(0 0 22px rgb(91 206 250 / 35%))
        drop-shadow(0 0 38px rgb(74 144 226 / 18%));
    }

    82% {
      opacity: 1;

      filter: brightness(1.08) contrast(1.1) saturate(1.08)
        drop-shadow(0 0 12px rgb(91 206 250 / 26%))
        drop-shadow(0 0 28px rgb(74 144 226 / 13%));
    }

    100% {
      opacity: 1;

      filter: brightness(1) contrast(1.08) saturate(1.05)
        drop-shadow(0 0 10px rgb(91 206 250 / 20%))
        drop-shadow(0 0 24px rgb(74 144 226 / 10%));
    }
  }

  /* --------------------------------
     Synapse overlay
  -------------------------------- */

  .synapse-layer {
    position: absolute;
    inset: 0;

    z-index: 10;

    pointer-events: none;
  }

  .synapse {
    position: absolute;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: white;

    opacity: 0;

    transform: translate(-50%, -50%) scale(0.25);

    box-shadow:
      0 0 4px white,
      0 0 8px var(--color-cyan),
      0 0 18px var(--color-cyan),
      0 0 32px rgb(91 206 250 / 55%);

    transition: none;
  }

  .synapse::before,
  .synapse::after {
    content: '';

    position: absolute;

    top: 50%;
    left: 50%;

    width: 22px;
    height: 1px;

    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 95%),
      rgb(91 206 250 / 70%),
      transparent
    );

    transform-origin: left center;

    opacity: 0;
  }

  .synapse::before {
    transform: rotate(28deg);
  }

  .synapse::after {
    transform: rotate(-42deg);
  }

  .synapse.active {
    animation: synapseFire 650ms ease-out forwards;
  }

  .synapse.active::before {
    animation: electricalBranch 520ms ease-out forwards;
  }

  .synapse.active::after {
    animation: electricalBranch 520ms ease-out 80ms forwards;
  }

  @keyframes synapseFire {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.2);
    }

    12% {
      opacity: 1;

      transform: translate(-50%, -50%) scale(1.9);

      box-shadow:
        0 0 5px white,
        0 0 12px white,
        0 0 20px var(--color-cyan),
        0 0 42px rgb(91 206 250 / 90%);
    }

    30% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    65% {
      opacity: 0.65;
      transform: translate(-50%, -50%) scale(0.75);
    }

    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.25);
    }
  }

  @keyframes electricalBranch {
    0% {
      width: 2px;
      opacity: 0;
    }

    20% {
      opacity: 1;
    }

    65% {
      width: 26px;
      opacity: 0.75;
    }

    100% {
      width: 34px;
      opacity: 0;
    }
  }


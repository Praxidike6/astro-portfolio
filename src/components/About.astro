      0 0 40px rgb(74 144 226 / 3%);
  }

  .about-visual::before {
    content: '';

    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(rgb(91 206 250 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(91 206 250 / 3%) 1px, transparent 1px);

    background-size: 32px 32px;

    opacity: 0.35;

    mask-image: radial-gradient(circle at center, black 15%, transparent 82%);

    pointer-events: none;
  }

  .brain-stage {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 520px;

    isolation: isolate;
  }

  .brain-stage::before {
    content: '';

    position: absolute;

    left: 10%;
    right: 8%;
    top: 15%;
    bottom: 8%;

    z-index: 0;

    border-radius: 50%;

    background: radial-gradient(
      ellipse at 48% 45%,
      rgb(255 255 255 / 12%) 0%,
      rgb(91 206 250 / 24%) 20%,
      rgb(74 144 226 / 14%) 44%,
      rgb(0 80 140 / 8%) 62%,
      transparent 80%

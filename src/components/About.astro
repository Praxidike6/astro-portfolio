<script>
  const synapses = Array.from(
    document.querySelectorAll<HTMLElement>('.synapse'),
  );

  const aboutVisual = document.querySelector<HTMLElement>('.about-visual');

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  let synapseTimer: ReturnType<typeof setTimeout> | null = null;
  let synapsesVisible = false;

  function randomBetween(min: number, max: number) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function fireSynapse(synapse: HTMLElement) {
    synapse.classList.remove('active');

    void synapse.offsetWidth;

    synapse.classList.add('active');

    window.setTimeout(() => {
      synapse.classList.remove('active');
    }, 700);
  }

  function fireRandomSynapses() {
    if (!synapsesVisible || prefersReducedMotion || synapses.length === 0) {
      return;
    }

    const firingCount = randomBetween(1, 3);

    const shuffled = [...synapses].sort(() => Math.random() - 0.5);

    const selected = shuffled.slice(0, firingCount);

    selected.forEach((synapse, index) => {
      window.setTimeout(
        () => {
          fireSynapse(synapse);
        },
        index * randomBetween(70, 180),
      );
    });

    const nextDelay = randomBetween(350, 1300);

    synapseTimer = window.setTimeout(fireRandomSynapses, nextDelay);
  }

  function startSynapses() {
    if (prefersReducedMotion || synapseTimer || synapses.length === 0) {
      return;
    }

    synapseTimer = window.setTimeout(
      fireRandomSynapses,
      randomBetween(300, 800),
    );
  }

  function stopSynapses() {
    if (synapseTimer) {
      window.clearTimeout(synapseTimer);
      synapseTimer = null;
    }

    synapses.forEach((synapse) => {
      synapse.classList.remove('active');
    });
  }

  if (aboutVisual && synapses.length && !prefersReducedMotion) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;

        synapsesVisible = entry.isIntersecting;

        if (synapsesVisible) {
          startSynapses();
        } else {
          stopSynapses();
        }
      },
      {
        threshold: 0.15,
      },
    );

    observer.observe(aboutVisual);
  }
</script>

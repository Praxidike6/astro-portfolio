---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/space-grotesk';

import '../styles/global.css';

import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Stuart McDonnell — Web Developer, Designer & Technologist',
  description =
    'Portfolio of Stuart McDonnell — web developer, designer and technology specialist creating accessible, responsive and engaging digital experiences.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = Astro.url;

const socialImageURL = new URL(image, Astro.site);

const baseURL = import.meta.env.BASE_URL;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',

  name: 'Stuart McDonnell',

  url: 'https://www.usethefalseluke.com',

  jobTitle: 'Web Developer, Designer & Technologist',

  description,

  image: socialImageURL.toString(),

  sameAs: [
    'https://www.linkedin.com/in/stuart-mcdonnell-762955166',
  ],

  knowsAbout: [
    'Web Development',
    'JavaScript',
    'TypeScript',
    'React',
    'Astro',
    'WordPress',
    'Accessibility',
    'Responsive Web Design',
  ],
};
---

<!doctype html>

<html lang='en'>
  <head>
    <meta charset='UTF-8' />

    <meta
      name='viewport'
      content='width=device-width, initial-scale=1'
    />

    <title>{title}</title>

    <meta
      name='description'
      content={description}
    />

    <link
      rel='canonical'
      href={canonicalURL}
    />

    <meta
      name='robots'
      content='index, follow'
    />

    <!-- Open Graph -->

    <meta
      property='og:type'
      content='website'
    />

    <meta
      property='og:title'
      content={title}
    />

    <meta
      property='og:description'
      content={description}
    />

    <meta
      property='og:url'
      content={canonicalURL}
    />

    <meta
      property='og:image'
      content={socialImageURL}
    />

    <meta
      property='og:image:alt'
      content='Stuart McDonnell — Web Developer, Designer and Technologist'
    />

    <meta
      property='og:site_name'
      content='Stuart McDonnell'
    />

    <meta
      property='og:locale'
      content='en_AU'
    />

    <!-- Twitter / X -->

    <meta
      name='twitter:card'
      content='summary_large_image'
    />

    <meta
      name='twitter:title'
      content={title}
    />

    <meta
      name='twitter:description'
      content={description}
    />

    <meta
      name='twitter:image'
      content={socialImageURL}
    />

    <meta
      name='twitter:image:alt'
      content='Stuart McDonnell — Web Developer, Designer and Technologist'
    />

    <!-- Browser theme -->

    <meta
      name='theme-color'
      content='#05070b'
    />

    <!-- Favicons -->

    <link
  rel='icon'
  type='image/svg+xml'
  href={`${baseURL}favicon.svg?v=2`}
/>

<link
  rel='icon'
  type='image/png'
  sizes='32x32'
  href={`${baseURL}favicon-32x32.png?v=2`}
/>

<link
  rel='icon'
  type='image/png'
  sizes='16x16'
  href={`${baseURL}favicon-16x16.png?v=2`}
/>

<link
  rel='alternate icon'
  type='image/x-icon'
  href={`${baseURL}favicon.ico?v=2`}
/>

<link
  rel='apple-touch-icon'
  sizes='180x180'
  href={`${baseURL}apple-touch-icon.png?v=2`}
/>

    <link
      rel='manifest'
      href={`${baseURL}site.webmanifest`}
    />

    <!-- Structured data -->

    <script
      type='application/ld+json'
      set:html={JSON.stringify(structuredData)}
    >
    </script>
  </head>

  <body id='top'>
    <a href="#main-content" class="skip-link">
  Skip to main content
</a>
    <Header />

    <main id='main-content' class='site-main'>
      <slot />
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const revealElements =
          document.querySelectorAll('.reveal');

        if (!revealElements.length) return;

        const revealObserver =
          new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.classList.add('visible');

                observer.unobserve(entry.target);
              });
            },
            {
              threshold: 0.15,
            },
          );

        revealElements.forEach((element) => {
          revealObserver.observe(element);
        });
      });
    </script>

    <script
      data-goatcounter='https://praxidike6.goatcounter.com/count'
      async
      src='https://gc.zgo.at/count.js'
    >
    </script>
  </body>
</html>